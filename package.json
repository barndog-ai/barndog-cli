{
  "name": "barndog",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "barndog": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "barndog": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "pnpm build",
    "typecheck": "tsc",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@barndog-ai/api-contract": "^0.1.0",
    "@inquirer/ansi": "^2.0.10",
    "@inquirer/checkbox": "^5.2.7",
    "@inquirer/confirm": "^6.3.4",
    "@inquirer/core": "^12.0.6",
    "@inquirer/input": "^5.1.9",
    "@inquirer/select": "^5.2.8",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "tar": "^7.5.22",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "Manage Skills, MCP configurations, Hooks, and shared knowledge across Claude Code, Codex, and Cursor.",
  "homepage": "https://barndog.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barndog-ai/barndog-cli.git"
  },
  "bugs": {
    "url": "https://github.com/barndog-ai/barndog-cli/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "cursor",
    "skills",
    "mcp",
    "hooks",
    "cli"
  ],
  "packageManager": "pnpm@12.10.1"
}
